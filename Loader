local function indexOf(list, v) for i, x in ipairs(list) do if x == v then return i - 1 end end return 0 end
local function isWebhook(url)
  return type(url) == "string" and (url:match("^https://discord%.com/api/webhooks/%d+/[%w%-_]+$") or
    url:match("^https://discordapp%.com/api/webhooks/%d+/[%w%-_]+$") or
    url:match("^https://ptb%.discord%.com/api/webhooks/%d+/[%w%-_]+$") or
    url:match("^https://canary%.discord%.com/api/webhooks/%d+/[%w%-_]+$")) ~= nil
end
local Settings = {}
for k, v in pairs(Defaults) do Settings[k] = v end
local dirty = false
local function validate(k, v)
  if Defaults[k] == nil or type(v) ~= type(Defaults[k]) then return nil, "unknown key or wrong type" end
  if type(v) == "number" and (v ~= v or v == math.huge or v == -math.huge) then return nil, "finite number required" end
  if k == "farmAvoid" then v = Util.clamp(v, 0, 100) end
  if k == "farmSpeed" then v = math.floor(Util.clamp(v, 5, 26)) end
  if k == "bagSize" then v = v >= 45 and 50 or 40 end  if k:sub(1, 3) == "key" then v = math.floor(Util.clamp(v, 0, 255)) end
  if k == "webhookUrl" then
    v = v:match("^%s*(.-)%s*$")
    if v ~= "" and not isWebhook(v) then return nil, "not a discord webhook url" end
  end
  if k == "webhookName" then
    v = v:match("^%s*(.-)%s*$"):sub(1, 80)
    local low = v:lower()
    if low:find("discord", 1, true) or low:find("clyde", 1, true) then return nil, "name can't contain discord or clyde" end
  end
  if k == "webhookEvery" then
    local best = HOOK_TIMES[1]
    for _, m in ipairs(HOOK_TIMES) do if math.abs(m - v) < math.abs(best - v) then best = m end end
    v = best
  end
  return v
end
local function set(k, value)
  local v, why = validate(k, value)
  if v == nil then return false, why end
  if Settings[k] ~= v then Settings[k], dirty = v, true end
  return true
end
