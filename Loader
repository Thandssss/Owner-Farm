local function waitUntil(cond, secs)
  local deadline = Util.now() + secs
  while Session.alive do local ok, done = pcall(cond) if ok and done then return true end if Util.now() >= deadline then return false end task.wait(0.25) end
  return false
end
task.spawn(function()
  if not waitUntil(function() return game.PlaceId ~= 0 end, 120) then if Session.alive then API.Unload() end return end
  if not inGame() then API.Unload() return end
  if not waitUntil(function() local p = Players.LocalPlayer return game:IsLoaded() and p and p:FindFirstChild("PlayerGui") end, 120) then if Session.alive then API.Unload() end return end
  if blockIfBlacklisted() then API.Unload() return end
