local Log = {lines = {}, file = nil}
function Log.add(kind, text)
  local okD, stamp = pcall(os.date, "%Y-%m-%d %H:%M:%S")
  local line = "[" .. (okD and stamp or string.format("%.1f", os.clock())) .. "] [" .. kind .. "] " .. tostring(text)
  table.insert(Log.lines, line)
  while #Log.lines > 300 do table.remove(Log.lines, 1) end
  if Log.file then pcall(appendfile, Log.file, line .. "\n") end
end
function Log.info(s) Log.add("info", s) end
function Log.warn(s) Log.add("warn", s) end
function Log.err(s) Log.add("err", s) end
function Log.dbg(s) Log.add("dbg", s) end
function Log.tail(n)
  local out = {}
  for i = math.max(1, #Log.lines - (n or 20) + 1), #Log.lines do out[#out + 1] = Log.lines[i] end
  return out
end

