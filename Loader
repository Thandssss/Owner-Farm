end

local STALL_EVERY, STALL_PAUSE = 5 * 60, 30
local LOADER_URL = "https://raw.githubusercontent.com/Thandssss/Owner-Farm/refs/heads/main/Loader"
local Stall = {nextAt = nil, resumeAt = nil, note = "off", warned = false}
function Stall.reload(reason)
  local url = LOADER_URL .. "?t=" .. tostring(math.floor(os.time()))
  local ok, src = pcall(function() return game:HttpGet(url) end)
  if not ok or type(src) ~= "string" then ok, src = pcall(function() return httpget(url) end) end
  if not (ok and type(src) == "string" and #src > 1000) then return false, "couldn't download the loader" end
  local fn, err = loadstring(src)
  if not fn then return false, "the loader doesn't compile: " .. tostring(err) end
  saveSettings()
  _G.MM2_Carry = makeCarry(reason or "anti-stall")
  Log.info((reason or "anti-stall") .. ": reloading the script")
  task.spawn(function() pcall(fn) end)
  return true
end
function Stall.step()
  local t = Util.now()
  if Stall.resumeAt then
    if Settings.antiStall and t < Stall.resumeAt then Stall.note = "paused" return 1 end
    Stall.resumeAt, Stall.nextAt = nil, t + STALL_EVERY
    if not Settings.farm then set("farm", true) uiSet("mm2_farm", true) end
    Log.info("anti-stall: farm back on")
    return 1
  end
  if not (Settings.antiStall and Settings.farm) then Stall.nextAt, Stall.note = nil, "off" return 1 end
  Stall.nextAt = Stall.nextAt or (t + STALL_EVERY)
  if t < Stall.nextAt then Stall.note = "waiting" return 1 end
  local me = Game.me
  if Game.map and me and me.alive then Stall.note = "reloading after this round" return 1 end
  if t - (Vote.openAt or -100) < 14 or Reset.active then Stall.note = "reloading after the vote" return 0.5 end
  local ok, why = Stall.reload()
  if ok then Stall.note = "reloading" return 5 end
  if not Stall.warned then Stall.warned = true Log.warn("anti-stall: can't reload (" .. why .. "), pausing the farm instead") end
  set("farm", false) uiSet("mm2_farm", false)
  Stall.resumeAt, Stall.note = t + STALL_PAUSE, "paused"
  Log.info("anti-stall: farm off for " .. STALL_PAUSE .. "s")
  return 1
end

local AF_SPEED, AF_COLLIDE_EVERY, AF_TICK = 250, 0.25, 0.03
local AntiFling = {safe = nil, safeChar = nil, blocked = 0, collideAt = -10}
local function isBodyPart(part)
  local c = part.ClassName
  return c == "Part" or c == "MeshPart" or c == "UnionOperation"
end
function AntiFling.uncollideOthers()
  local myId = Util.get(function() return Players.LocalPlayer.UserId end)
  for _, p in ipairs(Util.get(function() return Players:GetPlayers() end) or {}) do
    if Util.get(function() return p.UserId end) ~= myId then
      local ch = Util.get(function() return p.Character end)
      for _, part in ipairs(ch and Util.get(function() return ch:GetChildren() end) or {}) do
        if isBodyPart(part) then pcall(function() part.CanCollide = false end) end
      end
    end
  end
end
function AntiFling.stop(root)
  pcall(function() root.Velocity = Vector3.zero end)
  pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
end
function AntiFling.step()
  if not Settings.antiFling then AntiFling.safe = nil return 0.5 end
  local t = Util.now()
  if t - AntiFling.collideAt >= AF_COLLIDE_EVERY then
    AntiFling.collideAt = t
    AntiFling.uncollideOthers()
  end
  local me = Game.me
  local root = me and me.alive and me.root
  local killing = Reset.active or (Vote.killed and t - (Vote.killedAt or -100) < 3)
  if not root or killing then AntiFling.safe = nil return AF_TICK end
  local char = Util.get(function() return Players.LocalPlayer.Character.Address end)
  if char ~= AntiFling.safeChar then AntiFling.safe, AntiFling.safeChar = nil, char end
  local pos = Util.get(function() return root.Position end)
  local v = Util.get(function() return root.Velocity end)
  if not (pos and v) then return AF_TICK end
  local up = math.max(0, v.Y)
  local speed = math.sqrt(v.X * v.X + v.Z * v.Z + up * up)
  if speed > AF_SPEED then
    AntiFling.stop(root)
    if not Fly.active() and AntiFling.safe then pcall(function() root.Position = AntiFling.safe end) end
    AntiFling.blocked = AntiFling.blocked + 1
    if AntiFling.blocked == 1 or AntiFling.blocked % 10 == 0 then
      Log.info("anti-fling: blocked a fling (" .. AntiFling.blocked .. " this session)")
    end
  else
    AntiFling.safe = pos
  end
  return AF_TICK
end

local Keys = {binds = {}}
