local Game = {map = nil, holder = nil, coinContainer = nil, path = nil, scanAt = -10, mapName = nil, special = false,
  me = nil, murderers = {}, coins = {}, bag = 0, bagRound = nil, aliveAt = -10, alive = {}, roundId = 0, note = "lobby",
  bottom = nil, bottomRound = nil}
local NOT_MAPS = {Lobby = true, Camera = true, Terrain = true, PetContainer = true, RCCars = true, WeaponDisplays = true}
local PART_CLASSES = {Part = true, MeshPart = true, UnionOperation = true, WedgePart = true, CornerWedgePart = true, TrussPart = true}
local function isContainer(inst) local c = inst.ClassName return c == "Model" or c == "Folder" end
function Game.scanMap()
  local best, bestScore = nil, -1
  for _, top in ipairs(workspace:GetChildren()) do
    if isContainer(top) and not NOT_MAPS[top.Name] and not Players:FindFirstChild(top.Name) then
      local function consider(holder, sub)
        local cc = holder:FindFirstChild("CoinContainer")
        local spawns = holder:FindFirstChild("Spawns")
        if not cc and not spawns then return end
        local score = (cc and 1 or 0) + (spawns and 1000 or 0) + (top:FindFirstChild("Spawns") and 500 or 0)
        if score > bestScore then best, bestScore = {top = top.Name, sub = sub}, score end
      end
      consider(top, nil)
      for _, child in ipairs(top:GetChildren()) do
        if isContainer(child) and child.Name ~= "CoinContainer" then consider(child, child.Name) end
      end
    end
  end
  return best
end
function Game.resolve(path)
  local top = workspace:FindFirstChild(path.top)
  local holder = top and (path.sub and top:FindFirstChild(path.sub) or top)
  if not holder then return nil end
  local cc = holder:FindFirstChild("CoinContainer")
  if not cc then
    for _, child in ipairs(Util.get(function() return holder:GetChildren() end) or {}) do
      if isContainer(child) then cc = child:FindFirstChild("CoinContainer") if cc then break end end
    end
  end
  if not cc and not holder:FindFirstChild("Spawns") then return nil end
  return top, holder, cc
end
function Game.findMap()
  if Game.path then
    local top, holder, cc = Game.resolve(Game.path)
    if top then return top, holder, cc end
    Game.path = nil
  end
  local t = Util.now()
  if t - Game.scanAt < 1 then return nil end
  Game.scanAt = t
  Trace.mark("collector: looking for the map")
  local path = Game.scanMap()
  Trace.mark("collector: map scan done")
  if not path then return nil end
  Game.path = path
  return Game.resolve(path)
end
function Game.find(name)
  local holder, top = Game.holder, Game.map
  local hit = (holder and holder:FindFirstChild(name)) or (top and top ~= holder and top:FindFirstChild(name))
  if hit then return hit end
  for _, c in ipairs(holder and Util.get(function() return holder:GetChildren() end) or {}) do
    if isContainer(c) then local h = c:FindFirstChild(name) if h then return h end end
  end
  return workspace:FindFirstChild(name)
end
function Game.hasKnife(p, ch)
  local bp = p:FindFirstChild("Backpack")
  return ((bp and bp:FindFirstChild("Knife")) or (ch and ch:FindFirstChild("Knife"))) ~= nil
end
function Game.roundEnd()
  local st = Session.stats
  if st.roundBag > 0 then st.coins, st.rounds = st.coins + st.roundBag, st.rounds + 1 end
  st.roundBag = 0
end
function Game.collect()
  local map, holder, cc = Game.findMap()
  local name = map and (Game.path.sub and (Game.path.top .. "/" .. Game.path.sub) or Game.path.top) or nil
  if name ~= Game.mapName then
    local old = Game.mapName
    Game.mapName = name
    if old then Game.roundEnd() end
    if name then
      Game.roundId, Game.roundAt = Game.roundId + 1, Util.now()
      Session.stats.roundBag, Game.bag, Game.bagRound = 0, 0, nil
      Log.info("round on " .. name)
    end
  end
  Game.map, Game.holder, Game.coinContainer = map, holder, cc
  local special = map ~= nil and ((holder and (holder:FindFirstChild("ZombieSpawns") or holder:FindFirstChild("CustomGameMode")))
    or map:FindFirstChild("ZombieSpawns") or map:FindFirstChild("CustomGameMode")) ~= nil
  if special ~= Game.special then Game.special = special if special then Log.info("special round (zombies)") end end
  local t = Util.now()
  local refreshAlive = t - Game.aliveAt > 0.2
  if refreshAlive then Game.aliveAt = t end
  local lp = Players.LocalPlayer
  local myId = lp and lp.UserId
  local murderers, others, me = {}, {}, nil
  for _, p in ipairs(Players:GetPlayers()) do
    local id = p.UserId
    if refreshAlive then local ok, a = pcall(function() return p:GetAttribute("Alive") end) Game.alive[id] = not (ok and a == false) end
    local ch = p.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local knife = map ~= nil and Game.hasKnife(p, ch)
    local alive
    if special then
      local hp = hum and Util.get(function() return hum.Health end)
      alive = root ~= nil and (hp == nil or hp > 0)
    else
      alive = Game.alive[id] ~= false
    end
    local e = {id = id, name = p.Name, root = root, hum = hum, murderer = knife and not special, alive = alive}
    if id == myId then me = e elseif knife and alive and not special then murderers[#murderers + 1] = e end
    if id ~= myId and alive and root then others[#others + 1] = e end
  end
  if special and me and me.alive then
    local here = me.root and Util.get(function() return me.root.Position end)
    local sp = Game.spawnPos()
    if not here or (sp and (here - sp).Magnitude > 1500) then me.alive = false end
  end
  Game.me, Game.murderers, Game.others = me, murderers, others
  if not map then Game.note = "lobby"
  elseif me and not me.alive then Game.note = "out this round"
  else Game.note = "round on " .. tostring(name):lower() end
end
