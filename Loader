local Stats = {bg = nil, lines = {}, all = {}}
function Stats.new(kind, props)
  local d = Drawing.new(kind)
  for k, v in pairs(props) do pcall(function() d[k] = v end) end
  d.Visible = false
  Stats.all[#Stats.all + 1] = d
  return d
end
function Stats.init()
  if #Stats.all > 0 then return end
  Stats.bg = Stats.new("Square", {Filled = true, Color = Color3.fromRGB(15, 15, 15), Transparency = 0.35, ZIndex = 1})
  for i = 1, 14 do
    Stats.lines[i] = Stats.new("Text", {Size = 17, Center = false, Outline = true, Font = 2, Color = Color3.fromRGB(235, 235, 235), ZIndex = 2})
  end
end
local function capital(s) s = tostring(s or "") return s:sub(1, 1):upper() .. s:sub(2) end
function Stats.clock(s)
  s = math.max(0, math.floor(s))
  return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end
function Stats.total()
  local st = Session.stats
  return st.coins + (Game.map and st.roundBag or 0)
end
function Stats.fullPct(fullBags, rounds)
  if rounds <= 0 then return 0 end
  return math.min(100, math.floor(fullBags / rounds * 100 + 0.5))
end
function Stats.perHour(total, seconds)
  if seconds < 1 then return 0 end
  return math.floor(total / (seconds / 3600) + 0.5)
end
function Stats.hide() for _, d in ipairs(Stats.all) do pcall(function() d.Visible = false end) end end
function Stats.step()
  if not Settings.statsOverlay then Stats.hide() return 0.5 end
  Stats.init()
  local cam = workspace.CurrentCamera
  local vp = cam and Util.get(function() return cam.ViewportSize end)
  if not vp then Stats.hide() return 0.5 end
  local up = Util.now() - Session.started
  local total = Stats.total()
  local st = Session.stats
  Candy.balance = Candy.read() or Candy.balance
  local text = {
    "Total Running Time: " .. Stats.clock(up),
    "Candies Per Hour: " .. Stats.perHour(total, up),
    "Candies Collected: " .. total,
    "Candies Total: " .. (Candy.balance and commas(Candy.balance) or "?"),
    "Rounds: " .. st.rounds,
    "Full Bags: " .. st.fullBags,
    "Full Bag %: " .. Stats.fullPct(st.fullBags, st.rounds) .. "%",
    "Bag: " .. Game.bag .. " / " .. Settings.bagSize,
    "Farm: " .. (Stall.resumeAt and ("Anti-stall pause (" .. math.max(0, math.ceil(Stall.resumeAt - Util.now())) .. "s)")
      or capital(Settings.farm and Farm.phase or "off")),
    "Map: " .. (Game.mapName and not Farm.inLobby() and tostring(Game.mapName) or "Lobby"),
  }
  if Settings.antiFling then text[#text + 1] = "Flings Blocked: " .. AntiFling.blocked end
  if Settings.autoVote then
    text[#text + 1] = "Voting: " .. (Vote.pickName or "Waiting")
    text[#text + 1] = "Votes Cast: " .. (Vote.mapVotes or 0)
  end
  local w, lineH, pad = 260, 23, 11
  local h = #text * lineH + pad * 2 - 4
  local x, y = math.floor(vp.X - w - 16), math.floor(vp.Y / 2 - h / 2)
  Stats.bg.Position, Stats.bg.Size, Stats.bg.Visible = Vector2.new(x, y), Vector2.new(w, h), true
  for i, line in ipairs(Stats.lines) do
    if text[i] then
      line.Text = text[i]
      line.Position = Vector2.new(x + pad, y + pad + (i - 1) * lineH)
      line.Visible = true
    else
      line.Visible = false
    end
  end
  return 0.1
end
function Stats.remove()
  for _, d in ipairs(Stats.all) do pcall(function() d:Remove() end) end
  Stats.all, Stats.lines, Stats.bg = {}, {}, nil
end

local Hook = {queue = {}, nextAt = Session.hookNextAt, pending = false, testAt = -math.huge, testing = false,
  status = "nothing sent yet"}
function Hook.quiet() return not Fly.active() end
function Hook.post(url, payload)
  local body = HttpService:JSONEncode(payload)
  local target = url .. (url:find("?", 1, true) and "&" or "?") .. "wait=true"
  local ok, res = pcall(function() return httppost(target, body, "application/json") end)
  if not ok or type(res) ~= "string" then
    ok, res = pcall(function() return game:HttpPost(target, body, "application/json") end)
  end
  if not ok then return false, tostring(res) end
  local okJ, data = pcall(function() return HttpService:JSONDecode(res) end)
  if okJ and type(data) == "table" and data.id then return true end
  local why = okJ and type(data) == "table" and (data.message or (data.retry_after and "rate limited")) or res
  return false, tostring(why or "no reply"):sub(1, 120)
end
function Hook.player()
  return Util.get(function() return Players.LocalPlayer.Name end) or "unknown"
end
function Hook.name() return Settings.webhookName ~= "" and Settings.webhookName or HOOK_NAME end
Hook.candies = Candy.read
function Hook.statsPayload(title, s, description)
  return {
    username = Hook.name(),
    allowed_mentions = {parse = {}},
    embeds = {{
      title = title,
      description = description,
      color = 0x5865F2,
      fields = {
        {name = "Candies Total", value = s.balance and commas(s.balance) or "unknown", inline = true},
        {name = "Candies / Hour", value = commas(s.perHour), inline = true},
        {name = "Running Time", value = Stats.clock(s.up), inline = true},
        {name = "Full Bags", value = tostring(s.fullBags), inline = true},
        {name = "Rounds Total", value = tostring(s.rounds), inline = true},
        {name = "Full Bag %", value = Stats.fullPct(s.fullBags, s.rounds) .. "%", inline = true},
      },
    }},
  }
end
function Hook.sendStats()
  local up = Util.now() - Session.started
  local st = Session.stats
  local ok, why = Hook.post(Settings.webhookUrl, Hook.statsPayload(Hook.name() .. " Stats", {
    balance = Hook.candies(), perHour = Stats.perHour(Stats.total(), up), up = up,
    fullBags = st.fullBags, rounds = st.rounds,
  }))
  Hook.status = ok and "stats sent" or ("stats failed: " .. tostring(why))
  if not ok then Log.warn("webhook: " .. tostring(why)) end
  return ok
end
function Hook.sendTest()
  if Hook.testing then return end
  if not isWebhook(Settings.webhookUrl) then notifyUser("Discord", "Paste your webhook URL first.") return end
  local wait = math.ceil(5 - (Util.now() - Hook.testAt))
  if wait > 0 then notifyUser("Discord", string.format("Please wait %ds before testing again.", wait)) return end
  Hook.testing, Hook.testAt = true, Util.now()
  task.spawn(function()
    local ok, why = Hook.post(Settings.webhookUrl, Hook.statsPayload(Hook.name() .. " Stats (Test)",
      {balance = 0, perHour = 0, up = 0, fullBags = 0, rounds = 0},
      "This is a test message: your webhook is connected. Real stats will be posted here every "
        .. (HOOK_NAMES[indexOf(HOOK_TIMES, Settings.webhookEvery) + 1] or (Settings.webhookEvery .. " minutes")) .. "."))
    Hook.testing = false
    Hook.status = ok and "test sent" or ("test failed: " .. tostring(why))
    if not ok then Log.warn("webhook test: " .. tostring(why)) end
    notifyUser("Discord", ok and "Test sent. The webhook is working." or ("Test failed: " .. tostring(why)))
  end)
end
function Hook.step()
  local t = Util.now()
  if Settings.webhookOn and isWebhook(Settings.webhookUrl) then
    Hook.nextAt = Hook.nextAt or (t + Settings.webhookEvery * 60)
    if t >= Hook.nextAt and not Hook.pending then
      Hook.pending = true
      Hook.queue[#Hook.queue + 1] = {kind = "stats"}
    end
  else
    Hook.nextAt = nil
  end
  Session.hookNextAt = Hook.nextAt
  if #Hook.queue == 0 or not Hook.quiet() then return 1 end
  local job = table.remove(Hook.queue, 1)
  if job.kind == "stats" then
    Hook.pending = false
    if Settings.webhookOn and isWebhook(Settings.webhookUrl) then
      local ok = Hook.sendStats()
      if ok then
        local every, now = Settings.webhookEvery * 60, Util.now()
        local due = (Hook.nextAt or now) + every
        while due <= now do due = due + every end
        Hook.nextAt = due
      else
        Hook.nextAt = Util.now() + 60
      end
    end
  end
  return 1
end

