local function loop(name, body)
  task.spawn(function()
    local lastErr = -10
    while Session.alive do
      local ok, delay = pcall(body)
      if not ok then if Util.now() - lastErr > 5 then lastErr = Util.now() Log.err(name .. ": " .. tostring(delay)) end delay = 0.5 end
      if not Session.alive then break end
      task.wait(type(delay) == "number" and math.max(0.01, delay) or 0.05)
    end
  end)
end
