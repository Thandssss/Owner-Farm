function API.SetSetting(k, v)
  local ok, why
  if EXCLUSIVE[k] then ok, why = setExclusive(k, v) else ok, why = set(k, v) end
  if ok then
    if WIDGET[k] then uiSet(WIDGET[k], Settings[k]) end
    if k == "layDown" then uiSet("mm2_pose", Settings.layDown and 1 or 0) end
    if k == "farFromPlayers" then uiSet("mm2_target", Settings.farFromPlayers and 1 or 0) end
    if k == "directRoute" then uiSet("mm2_route", Settings.directRoute and 1 or 0) end
    if k == "resetOffsets" then uiSet("mm2_reset_method", Settings.resetOffsets and 1 or 0) end
    if k == "bagSize" then uiSet("mm2_bag", indexOf(BAGS, Settings.bagSize)) end  end
  return ok, why
end
function API.Unload()
  if not Session.alive then return end
  Session.alive = false
  Reset.active = false
  AntiAfk.queue = nil
  for _, c in ipairs(Session.conns) do pcall(function() c:Disconnect() end) end
  Session.conns = {}
  Fly.cancel()
  if Fly.laid then Fly.standUp() end
  Fly.restoreCollision()
  if Session.loaded then saveSettings() end
  Stats.remove()
  pcall(UI.RemoveTab, TAB)
  pcall(setrobloxinput, true)
  if _G[NAME] == API then _G[NAME] = nil end
end
