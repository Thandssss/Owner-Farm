_G.MM2_Carry = nil
local function makeCarry(reason)
  local now = os.clock()
  return {reason = reason, startedAt = Session.startedAt, elapsed = now - Session.started, savedAt = wallTime(),
    stats = Session.stats, hookIn = Session.hookNextAt and (Session.hookNextAt - now) or nil}
end
local function applyCarry(c)
  if type(c) ~= "table" then return end
  local now = os.clock()
  if type(c.elapsed) == "number" then
    local gap = type(c.savedAt) == "number" and math.max(0, wallTime() - c.savedAt) or 0
    Session.started = now - c.elapsed - gap
    if type(c.hookIn) == "number" then Session.hookNextAt = now + math.max(0, c.hookIn - gap) end
  else
    Session.started = type(c.started) == "number" and c.started or Session.started
    Session.hookNextAt = c.hookNextAt
  end
  Session.startedAt = c.startedAt or Session.startedAt
  if type(c.stats) == "table" then Session.stats = c.stats end
end
