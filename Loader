function UIState.step()
  if not Session.built then return 0.25 end
  for _, s in ipairs(SYNC) do
    local ok, raw = pcall(UI.GetValue, s.id)
    if ok and raw ~= nil and raw ~= UIState.last[s.id] then
      UIState.last[s.id] = raw
      local v = raw
      if s.map then v = s.map(raw) end
      if v ~= nil and v ~= Settings[s.key] then
        local okSet = (s.exclusive and setExclusive or set)(s.key, v)
        if s.after then pcall(s.after, v, okSet) end
      end
    end
  end
  return 0.25
end
