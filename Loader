function Game.mapBottom()
  if Game.bottomRound == Game.roundId then return Game.bottom end
  local map = Game.map
  if not map then return nil end
  local lo, n = math.huge, 0
  Trace.mark("farm: measuring the map bottom")
  local function measure(d)
    if PART_CLASSES[d.ClassName] then
      local pos = Util.get(function() return d.Position end)
      local size = pos and Util.get(function() return d.Size end)
      if size then lo = math.min(lo, pos.Y - size.Y / 2) end
      n = n + 1
      if n % 1500 == 0 then task.wait() end
    end
  end
  for _, child in ipairs(Util.get(function() return map:GetChildren() end) or {}) do
    if child.Name ~= "CoinContainer" then
      measure(child)
      for _, d in ipairs(Util.get(function() return child:GetDescendants() end) or {}) do measure(d) end
    end
  end
  Game.bottom, Game.bottomRound = lo < math.huge and lo or nil, Game.roundId
  Trace.mark("farm: map bottom measured")
  if Game.bottom then Log.info(string.format("map bottom at y %.1f (%d parts)", Game.bottom, n)) end
  return Game.bottom
end
