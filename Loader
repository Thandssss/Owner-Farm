-- Movement: zero velocity and spin straight in memory, which Matcha's properties can't do for spin.
-- The physics data is found once per character and re-checked before every write, so a Roblox update
-- just turns this off.
local Still = {prim = nil, primOff = nil, posOff = nil, rootId = nil, triedId = nil}
local function memRead(kind, addr)
  local ok, v = pcall(memory_read, kind, addr)
  if ok then return v end
end
function Still.matches(addr, p)
  local x, y, z = memRead("float", addr), memRead("float", addr + 4), memRead("float", addr + 8)
  return x and y and z and math.abs(x - p.X) < 0.05 and math.abs(y - p.Y) < 0.05 and math.abs(z - p.Z) < 0.05
end
function Still.isRotation(addr)
  for i = 0, 2 do
    local x, y, z = memRead("float", addr + i * 12), memRead("float", addr + i * 12 + 4), memRead("float", addr + i * 12 + 8)
    if not (x and y and z) or math.abs(x * x + y * y + z * z - 1) > 0.02 then return false end
  end
  return true
end
function Still.bind(root, id)
  if Still.rootId == id then return true end
  if Still.triedId == id or type(memory_read) ~= "function" or type(memory_write) ~= "function" then return false end
  Still.triedId, Still.rootId, Still.prim = id, nil, nil
  local p = Util.get(function() return root.Position end)
  if not p then return false end
  for _, primOff in ipairs({0x178, 0x180}) do
    local prim = memRead("uintptr", id + primOff)
    if type(prim) == "number" and prim > 0x10000 and prim < 0x7FFFFFFFFFFF then
      for posOff = 0x24, 0x300, 4 do
        if Still.matches(prim + posOff, p) and Still.isRotation(prim + posOff - 0x24) then
          Still.prim, Still.primOff, Still.posOff, Still.rootId = prim, primOff, posOff, id
          return true
        end
      end
    end
  end
  Log.warn("lying: couldn't find the physics data in memory, using normal writes only")
  return false
end
function Still.stop(root)
  local id = Util.get(function() return root.Address end)
  if not id or not Still.bind(root, id) then return end
  if memRead("uintptr", id + Still.primOff) ~= Still.prim then Still.rootId, Still.triedId = nil, nil return end
  local addr = Still.prim + Still.posOff
  local p, y = Util.get(function() return root.Position end), memRead("float", addr + 4)
  if not (p and y) or math.abs(p.Y - y) > 40 then Still.rootId, Still.triedId = nil, nil return end
  for off = 0xC, 0x20, 4 do pcall(memory_write, "float", addr + off, 0) end
end
function Fly.standUp()
  Fly.laid = false
  Fly.animOn()
  local root, p = Fly.root(), Fly.here()
  if root and p then pcall(function() root.CFrame = CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, Fly.yaw, 0) end) end
end
local LIE_YAW = 0
function Fly.lieYaw() return LIE_YAW end
function Fly.lieCFrame(pos) return CFrame.new(pos.X, pos.Y, pos.Z) * CFrame.Angles(0, Fly.lieYaw(), 0) * LAY_TILT end
function Fly.place(root, pos)
  if Fly.lyingFor(Fly.mode) then
    Fly.laid = true
    Fly.animOff()
    Still.stop(root)
    return pcall(function() root.CFrame = Fly.lieCFrame(pos) end)
  end
  if Fly.laid then Fly.standUp() end
  return pcall(function() root.Position = pos end)
end
function Fly.root() return Game.myRoot() end
function Fly.here() return Util.get(function() return Fly.root().Position end) end
local NOCLIP_EVERY = 0.1
function Fly.noclip()
  local t = Util.now()
  if t - (Fly.noclipAt or -10) < NOCLIP_EVERY then return end
  Fly.noclipAt = t
  for _, part in ipairs(Fly.parts) do pcall(function() part.CanCollide = false end) end
end
Fly.orig, Fly.origChar = {}, nil
function Fly.refreshParts()
  Fly.parts = {}
  local ch = Util.get(function() return Players.LocalPlayer.Character end)
  local id = ch and Util.get(function() return ch.Address end)
  if id ~= Fly.origChar then Fly.origChar, Fly.orig = id, {} end
  for _, part in ipairs(ch and Util.get(function() return ch:GetChildren() end) or {}) do
    if part.ClassName == "Part" or part.ClassName == "MeshPart" then
      Fly.parts[#Fly.parts + 1] = part
      if Fly.orig[part.Name] == nil then
        local ok, v = pcall(function() return part.CanCollide end)
        if ok and type(v) == "boolean" then Fly.orig[part.Name] = v end
      end
    end
  end
end
function Fly.restoreCollision()
  for _, part in ipairs(Fly.parts) do
    local v = Fly.orig[part.Name]
    if v ~= nil then pcall(function() part.CanCollide = v end) end
  end
end
function Fly.zero(root)
  pcall(function() root.Velocity = Vector3.zero end)
end
function Fly.cancel()
  Fly.path, Fly.leg = nil, 0
end
function Fly.active() return Fly.path ~= nil end
function Fly.start(points, mode)
  Fly.cancel()
  local from = Fly.here()
  if not from then return false end
  Fly.refreshParts()
  Fly.mode = mode or "move"
  if Fly.laid and not Fly.lyingFor(Fly.mode) then Fly.standUp() end
  Fly.facing(Fly.root())
  Fly.path, Fly.leg, Fly.legTo = points, 0, from
  return true
end
function Fly.nextLeg()
  Fly.leg = Fly.leg + 1
  local goal = Fly.path[Fly.leg]
  if not goal then return false end
  Fly.legFrom = Fly.legTo or Fly.here()
  Fly.legTo = goal
  Fly.legAt = Util.now()
  Fly.legSpeed = Fly.speed()
  Fly.legDur = math.max((goal - Fly.legFrom).Magnitude / math.max(Fly.legSpeed, 0.01), 0.1)
  return true
end
function Fly.tick()
  if not Fly.path then return true end
  local root = Fly.root()
  if not root then return false end
  Fly.noclip()
  local t = Util.now()
  if Fly.leg == 0 then Fly.nextLeg() end
  if Fly.leg > #Fly.path then
    if Fly.laid then
      if t - (Fly.pinAt or -10) >= LAY_PARK_EVERY then Fly.pinAt = t Fly.place(root, Fly.legTo) end
      if t - Fly.zeroAt >= LAY_ZERO_EVERY then Fly.zeroAt = t Fly.zero(root) end
    elseif t - Fly.zeroAt >= 0.1 then Fly.zeroAt = t Fly.place(root, Fly.legTo) Fly.zero(root) end
    return true
  end
  local alpha = Util.clamp((t - Fly.legAt) / Fly.legDur, 0, 1)
  local speed = Fly.speed()
  if Fly.legSpeed ~= speed and alpha < 1 then
    local cur = Fly.legFrom:Lerp(Fly.legTo, alpha)
    Fly.legFrom, Fly.legAt, Fly.legSpeed = cur, t, speed
    Fly.legDur = math.max((Fly.legTo - cur).Magnitude / math.max(speed, 0.01), 0.1)
    alpha = 0
  end
  if t - Fly.zeroAt >= (Fly.laid and LAY_ZERO_EVERY or 0.05) then Fly.zeroAt = t Fly.zero(root) end
  if alpha >= 1 then
    Fly.place(root, Fly.legTo)
    if not Fly.nextLeg() then Fly.leg = #Fly.path + 1 return true end
  else
    Fly.place(root, Fly.legFrom:Lerp(Fly.legTo, alpha))
  end
  return false
end
local TICK = 0.03

local Farm = {phase = "off", note = "farm off", target = nil, targetAt = 0, nextAt = 0, holdAt = nil, skip = {}, collected = 0,
  misses = 0, full = false, flew = false, parking = false, parked = false, startPos = nil, released = true}
function Farm.release()
  Farm.released = true
  Fly.restoreCollision()
  local root = Game.myRoot()
  if root then pcall(function() root.AssemblyLinearVelocity = Vector3.zero end) end
  if Util.get(isrbxactive) then toGame(function() keypress(0x20) task.wait(0.05) keyrelease(0x20) end) end
  Log.info("farm off: control handed back")
end
local FLOOR_BELOW_COIN = 1.8
function Farm.reset()
  Fly.cancel()
  Farm.target, Farm.holdAt, Farm.parking = nil, nil, false
end
function Farm.stop(why)
  Farm.target, Farm.holdAt = nil, nil
  Farm.phase, Farm.note = "idle", why or "idle"
end
function Farm.route(goal, travelY, mode)
  local from = Fly.here()
  if not from then return false end
  if not Farm.flew then Farm.startPos = from end
  Farm.flew = true
  if mode == "coin" and Settings.directRoute and Fly.lyingFor(mode) then
    local hide = goal.Y - LAY_HIDE
    local points = {Vector3.new(goal.X, hide, goal.Z), goal}
    if from.Y > hide then table.insert(points, 1, Vector3.new(from.X, hide, from.Z)) end
    return Fly.start(points, mode)
  end
  if mode == "coin" and Settings.directRoute then return Fly.start({goal}, mode) end
  return Fly.start({Vector3.new(from.X, math.min(from.Y, travelY), from.Z), Vector3.new(goal.X, travelY, goal.Z), goal}, mode)
end
function Farm.startPark(force)
  if not (force or Settings.farmReturn) or not Game.map or not Farm.flew then Farm.reset() return false end
  local sp = Game.spawnPos() or (Farm.startPos and Farm.startPos - Vector3.new(0, 3, 0))
  if not sp then Farm.reset() return false end
  Farm.parking = Farm.route(sp + Vector3.new(0, 3, 0), sp.Y - FARM_TRAVEL, "move")
  return Farm.parking
end
function Farm.lobbyPos()
  if Farm.lobbyRef then return Farm.lobbyRef end
  local lobby = workspace:FindFirstChild("Lobby")
  local box = lobby and lobby:FindFirstChild("Box")
  Farm.lobbyRef = box and Util.get(function() return box.Position end)
  return Farm.lobbyRef
end
-- The lobby sits well above every map, and the old map stays loaded for a while after you're sent back.
function Farm.inLobby()
  local here, lobby = Fly.here(), Farm.lobbyPos()
  if not (here and lobby) or here.Y < lobby.Y - 40 then return false end
  local dx, dz = here.X - lobby.X, here.Z - lobby.Z
  return dx * dx + dz * dz < 250 * 250
end
function Farm.onMap(here)
  if not (Game.map and here) then return false end
  local sp = Game.spawnPos()
  if sp then return (here - sp).Magnitude < 1500 end
  local lobby = Farm.lobbyPos()
  return lobby ~= nil and (here - lobby).Magnitude > 500
end
function Farm.underY(here)
  local y = here.Y - VOID_GAP
  local bottom = Game.mapBottom()
  if bottom then y = math.min(y, bottom - VOID_GAP) end
  local low = Game.spawnLow()
  if low then y = math.min(y, low - VOID_GAP) end
  return math.max(y, VOID_MIN)
end
function Farm.goUnder(why)
  local here = Fly.here()
  if not here then return false end
  local y = Farm.underY(here)
  here = Fly.here()
  if not Session.alive or not here then return false end
  if not Farm.flew then Farm.startPos = here end
  Farm.flew = true
  Log.info(string.format("%s: going under the map to y %.1f (from %.1f)", why, y, here.Y))
  return Fly.start({Vector3.new(here.X, math.min(y, here.Y), here.Z)}, "move")
end
function Farm.startDive()
  local here = Fly.here()
  if not here or not Farm.onMap(here) then return false end
  return Farm.goUnder("start under map")
end
function Farm.startHold() return Farm.goUnder("xp farm") end
function Farm.otherPositions()
  local out = {}
  for _, o in ipairs(Game.others or {}) do
    local p = o.root and Util.get(function() return o.root.Position end)
    if p then out[#out + 1] = p end
  end
  return out
end
function Farm.nearestOther(p, others)
  local best = math.huge
  for _, op in ipairs(others) do local d = (p - op).Magnitude if d < best then best = d end end
  return best
end
function Farm.score(item, others)
  if not Settings.farFromPlayers then return item.d end
  local od = Farm.nearestOther(item.p, others)
  if od > item.d then return item.d end
  return 10000 + (item.d - od)
end
function Farm.dangerPositions()
  local out = {}
  if not (Settings.avoidMurderer and Settings.farmAvoid > 0) or not Game.me or Game.me.murderer then return out end
  for _, m in ipairs(Game.murderers) do local p = m.root and Util.get(function() return m.root.Position end) if p then out[#out + 1] = p end end
  return out
end
function Farm.nearDanger(p, danger)
  for _, mp in ipairs(danger) do if (p - mp).Magnitude < Settings.farmAvoid then return true end end
  return false
end
function Farm.threatened(tgt, t)
  if t - (Farm.dangerAt or -10) < 0.1 then return false end
  Farm.dangerAt = t
  return Farm.nearDanger(tgt.p, Farm.dangerPositions())
end
function Farm.pick(root)
  local rp = Fly.here() or Util.get(function() return root.Position end)
  if not rp then return nil end
  local danger = Farm.dangerPositions()
  local others = Settings.farFromPlayers and Farm.otherPositions() or {}
  local list, t = {}, Util.now()
  local closest, closestD, closestWhy = nil, math.huge, nil
  for _, c in ipairs(Game.coins) do
    local p = Util.get(function() return c.Position end)
    local key = p and string.format("%s@%.2f,%.2f,%.2f", tostring(Util.get(function() return c.Address end)), p.X, p.Y, p.Z)
    if p then
      local d = (p - rp).Magnitude
      local why
      if Farm.skip[key] and Farm.skip[key] > t then
        why = "skipped (collected, missed or contested recently)"
      else
        if Farm.nearDanger(p, danger) then why = "within " .. Settings.farmAvoid .. " studs of the murderer" end
      end
      if not why then
        local item = {c = c, p = p, key = key, d = d}
        item.score = Farm.score(item, others)
        if item.score >= 10000 then why = "another player is closer to it" end
        list[#list + 1] = item
      end
      if d < closestD then closest, closestD, closestWhy = key, d, why end
    end
  end
  table.sort(list, function(a, b) return a.score < b.score end)
  for i = 1, math.min(#list, 6) do
    local item = list[i]
    if not Game.coinTaken(item.c) then
      if closest and closest ~= item.key and item.d > closestD + 8 and t - (Farm.whyAt or -10) > 3 then
        Farm.whyAt = t
        Log.info(string.format("pick: went %d studs, closest candy (%d studs) was %s", math.floor(item.d), math.floor(closestD),
          closestWhy or "already collected"))
      end
      return item
    end
    Farm.skip[item.key] = t + 30
  end
  return nil
end
function Farm.step()
  local me = Game.me
  if Fly.laid and not (Fly.active() and Fly.lyingFor(Fly.mode)) then Fly.standUp() end
  if Settings.farm then Farm.released = false
  elseif not Farm.released and not Fly.active() then Farm.release() end
  if not Game.map then
    if Farm.phase ~= "waiting" or Fly.active() then Farm.reset() end
    Farm.phase, Farm.note, Farm.parked, Farm.flew = Settings.farm and "waiting" or "off", Settings.farm and "waiting for a round" or "farm off", false, false
    Farm.skip, Farm.misses, Farm.full, Farm.startPos = {}, 0, false, nil
    return 0.5
  end
  if not (me and me.root and me.alive) then
    Farm.reset() Farm.flew = false Farm.phase, Farm.note = Settings.farm and "waiting" or "off", "out this round" return 0.2 end
  if Farm.inLobby() then
    if Farm.phase ~= "waiting" or Fly.active() then Farm.reset() end
    Farm.flew = false Farm.phase, Farm.note = Settings.farm and "waiting" or "off", "in the lobby"
    return 0.2
  end
  if Farm.parking then
    Farm.phase, Farm.note = "returning", "flying back to the spawn"
    if Fly.tick() then Farm.reset() Farm.parked, Farm.flew = true, false Farm.phase, Farm.note = Settings.farm and "full" or "off", Settings.farm and "bag full" or "farm off" end
    return TICK
  end
  if not Settings.farm then
    if Farm.phase ~= "off" then
      Farm.stop("farm off")
      if Farm.flew and Farm.startPark(true) then return TICK end
      Farm.reset() Farm.phase = "off"
    end
    return 0.3
  end
  if Game.bag >= Settings.bagSize or Farm.full then
    if Farm.phase ~= "full" and Farm.phase ~= "holding" then
      Log.info("candy bag full") Farm.stop("bag full") Farm.phase = "full" Session.stats.fullBags = Session.stats.fullBags + 1
      if not Settings.xpFarm then
        if not Farm.parked and Farm.startPark() then return TICK end
        Farm.reset()
      end
    end
    if Settings.xpFarm then
      if Farm.phase ~= "holding" then
        if not Farm.startHold() then return 0.5 end
        Farm.phase, Farm.note = "holding", "holding under the map"
      end
      Fly.tick()
      return TICK
    end
    if Farm.phase == "holding" then
      Farm.phase = "full"
      if Farm.startPark(true) then return TICK end
      Farm.reset()
    end
    return 0.5
  end
  Farm.parked = false
  local t = Util.now()
  local tgt = Farm.target
  if tgt then
    local taken = false
    if t - (Farm.checkAt or -10) >= 0.2 then
      Farm.checkAt = t
      Game.listCoins()
      taken = Game.coinTaken(tgt.c)
    end
    if taken and Farm.holdAt then
      Trace.mark("farm: candy collected")
      Farm.collected, Farm.misses = Farm.collected + 1, 0
      Farm.skip[tgt.key] = t + 30
      Farm.target, tgt, Farm.holdAt, Farm.nextAt = nil, nil, nil, t + FARM_DELAY
    elseif taken then
      Farm.skip[tgt.key] = t + 30
      Farm.target, tgt = nil, nil
    elseif Farm.holdAt and t - Farm.holdAt > 1.5 then
      Farm.skip[tgt.key] = t + 20
      Farm.misses = Farm.misses + 1
      if Farm.misses >= 4 and Game.bag > 0 then Farm.full = true Log.info("candies stopped counting at " .. Game.bag) end
      Farm.target, tgt, Farm.holdAt = nil, nil, nil
    elseif t - Farm.targetAt > 30 then
      Farm.skip[tgt.key] = t + 20
      Farm.target, tgt, Farm.holdAt = nil, nil, nil
    elseif Farm.threatened(tgt, t) then
      Farm.skip[tgt.key] = t + 5
      Fly.cancel()
      Farm.target, tgt, Farm.holdAt = nil, nil, nil
      if t - (Farm.fledAt or -10) > 3 then Farm.fledAt = t Log.info("avoid: murderer within " .. Settings.farmAvoid .. " studs, dropped the candy") end
    elseif Settings.farFromPlayers and not Farm.holdAt and t - (Farm.contestAt or -10) >= 0.25 then
      Farm.contestAt = t
      local here = Fly.here()
      local od = Farm.nearestOther(tgt.p, Farm.otherPositions())
      if here and od + 2 < (tgt.p - here).Magnitude then
        Farm.skip[tgt.key] = t + 5
        Farm.contested = (Farm.contested or 0) + 1
        Farm.target, tgt = nil, nil
      end
    end
  end
  if not tgt and t < Farm.nextAt then
    if Fly.active() then Fly.tick() end
    Farm.phase, Farm.note = "farming", "next candy"
    return TICK
  end
  if not tgt then
    if Farm.phase == "searching" and t - (Farm.listAt or -10) < 0.1 then
      if Fly.active() then Fly.tick() end
      return TICK
    end
    Farm.listAt = t
    Trace.mark("farm: listing candies")
    Game.listCoins()
    Trace.mark("farm: picking a candy")
    tgt = Farm.pick(me.root)
    Trace.mark("farm: picked")
    if not tgt then
      Farm.phase, Farm.note = "searching", (#Game.coins == 0 and "no candies yet" or "no safe candy")
      local here = not Fly.active() and t - (Farm.hideAt or -10) > 3 and Fly.here()
      if here and Farm.nearDanger(here, Farm.dangerPositions()) and Farm.goUnder("avoid: murderer nearby") then
        Farm.hideAt = t
        Fly.tick() Farm.note = "hiding from the murderer"
      elseif Fly.active() then Fly.tick()
      elseif Settings.startUnder and Farm.startDive() then Fly.tick() Farm.note = "waiting under the map" end
      return TICK
    end
    local here = Fly.here()
    if not here or (tgt.p - here).Magnitude > 1500 then Farm.phase, Farm.note = "waiting", "not on the map" return 0.5 end
    Farm.target, Farm.targetAt, Farm.holdAt = tgt, t, nil
    Trace.mark("farm: flying to a candy")
    Farm.route(tgt.p - Vector3.new(0, Settings.layDown and LAY_DEPTH or FARM_DEPTH, 0), tgt.p.Y - FLOOR_BELOW_COIN - FARM_TRAVEL, "coin")
  end
  Farm.phase = "farming"
  Farm.note = Util.count(Farm.collected, "candy", "candies") .. " collected, " .. Util.count(#Game.coins, "candy", "candies") .. " left"
  if Fly.tick() and not Farm.holdAt then
    Farm.holdAt = t
    Trace.mark("farm: under the candy, waiting for it to count")
  end
  return TICK
end

local VK_ESC, VK_R, VK_ENTER = 0x1B, 0x52, 0x0D
local Reset = {active = false, round = nil, cycles = 0, note = "off", method = nil, killAt = 0,
  stage = "esc", at = 0, menuSeen = false, menuBlind = false}
local MENU_OPEN_WAIT, BLIND_MENU_WAIT, MENU_SETTLE, R_WAIT, DEATH_WAIT = 3, 1.2, 0.35, 0.6, 2.5
local KEY_HOLD = 0.2
local HEALTH_OFFSETS = {0x184, 0x19c}
local KILL_TIMEOUT = 3
function Reset.full()
  return Game.map ~= nil and ((Game.bagRound == Game.roundId and Game.bag >= Settings.bagSize) or Farm.full)
end
function Reset.done()
  local me = Game.me
  if not Game.map or not (me and me.alive) or Farm.phase == "waiting" then return true end
  if Reset.method == "offsets" then return false end
  local hp = me.hum and Util.get(function() return me.hum.Health end)
  return hp ~= nil and hp <= 0
end
function Reset.healthAddress(hum)
  local a = Util.get(function() return hum.Address end)
  local hp, mx = Util.get(function() return hum.Health end), Util.get(function() return hum.MaxHealth end)
  if not (a and hp and mx) or hp <= 0 then return nil end
  for _, off in ipairs(HEALTH_OFFSETS) do
    local ok, f = pcall(memory_read, "float", a + off)
    if not ok or type(f) ~= "number" or (math.abs(f - hp) > 0.01 and math.abs(f - mx) > 0.01) then return nil end
  end
  return a
end
function Reset.kill()
  local hum = Game.me and Game.me.hum
  local a = hum and Reset.healthAddress(hum)
  if not a then return false end
  for _, off in ipairs(HEALTH_OFFSETS) do pcall(memory_write, "float", a + off, 0) end
  return true
end
function Reset.press(vk, hold)
  toGame(function() keypress(vk) task.wait(hold or 0.05) keyrelease(vk) end)
end
function Reset.menuOpen()
  local shield = Util.get(function() return game:GetService("CoreGui").RobloxGui.SettingsClippingShield.SettingsShield end)
  local p = shield and Util.get(function() return shield.AbsolutePosition end)
  if not p then return nil end
  local vp = Util.get(function() return workspace.CurrentCamera.ViewportSize end)
  return p.Y < (vp and vp.Y or 1080) * 0.5
end
function Reset.hold(vk)
  pcall(function() keypress(vk) task.wait(KEY_HOLD) keyrelease(vk) end)
end
function Reset.keysStep()
  if not Util.get(isrbxactive) then Reset.note = "click into Roblox" return 0.25 end
  local t, open = Util.now(), Reset.menuOpen()
  if open then Reset.menuSeen = true end
  local blind = Reset.menuBlind or open == nil
  if Reset.stage == "close" then
    if blind or not open or Reset.closes >= 3 then Reset.stage = "esc" return 0.3 end
    Reset.hold(VK_ESC)
    Reset.closes, Reset.note = Reset.closes + 1, "closing menu"
    return 0.6
  elseif Reset.stage == "esc" then
    if open and not blind then Reset.stage, Reset.closes = "close", 0 return 0.05 end
    Reset.hold(VK_ESC)
    Reset.stage, Reset.at, Reset.note = "open", t, "opening menu"
    return 0.1
  elseif Reset.stage == "open" then
    if blind then
      if t - Reset.at < BLIND_MENU_WAIT then return 0.1 end
      Reset.stage = "r" return 0.05
    end
    if open then Reset.stage = "r" return MENU_SETTLE end
    if t - Reset.at < MENU_OPEN_WAIT then return 0.1 end
    if not Reset.menuSeen then
      Reset.menuBlind = true
      Log.warn("reset: can't see the Esc menu, using timed keys")
      Reset.stage = "r" return 0.05
    end
    Reset.stage = "esc" return 0.1
  elseif Reset.stage == "r" then
    Reset.hold(VK_R)
    Reset.stage, Reset.note = "enter", "confirming reset"
    return R_WAIT
  elseif Reset.stage == "enter" then
    Reset.hold(VK_ENTER)
    Reset.stage, Reset.at, Reset.cycles = "dying", t, Reset.cycles + 1
    return 0.25
  end
  if t - Reset.at < DEATH_WAIT then Reset.note = "waiting for death" return 0.25 end
  Reset.stage, Reset.closes = "close", 0
  return 0.1
end
function Reset.step()
  if not (Settings.autoReset and Settings.farm) then
    Reset.active, Reset.stage, Reset.method, Reset.note = false, "esc", nil, "off"
    return 0.5
  end
  if not Reset.active then
    if not Game.map then Reset.note = "waiting for a round" return 0.5 end
    if Reset.round == Game.roundId then Reset.note = "done, waiting for the next round" return 0.5 end
    if not Reset.full() then Reset.note = "watching the bag" return 0.5 end
    if Reset.done() then Reset.round = Game.roundId Reset.note = "already out this round" return 0.5 end
    Reset.active, Reset.stage, Reset.cycles, Reset.method = true, "esc", 0, nil
    Log.info("reset: bag full (" .. Game.bag .. ")")
  end
  if Reset.done() then
    local how = not Game.map and "round ended first"
      or (Reset.method == "offsets" and "health offsets")
      or (Reset.stage == "dying" and "keys")
      or "died another way"
    Log.info("reset: done (" .. how .. ", " .. Util.count(Reset.cycles, "key attempt", "key attempts") .. ")")
    if Reset.method == "keys" and Reset.menuOpen() and Util.get(isrbxactive) then Reset.press(VK_ESC, KEY_HOLD) end
    Reset.active, Reset.round, Reset.method, Reset.stage = false, Game.roundId, nil, "esc"
    Reset.note = "done, waiting for the next round"
    return 0.5
  end
  if Reset.method == nil then
    if Settings.resetOffsets and Reset.kill() then
      Reset.method, Reset.killAt, Reset.note = "offsets", Util.now(), "health set to 0"
      Log.info("reset: health offsets set to 0")
      return 0.25
    end
    if Settings.resetOffsets then
      Log.warn("reset: health offsets unavailable (Unsafe LuaU is off or Roblox updated), using keys")
      notifyUser("mm2", "Offsets are unavailable, so resetting with Esc + R + Enter.")
    end
    Reset.method = "keys"
  end
  if Reset.method == "offsets" then
    if Util.now() - Reset.killAt < KILL_TIMEOUT then Reset.note = "waiting for death" return 0.25 end
    Reset.method = "keys"
    Log.warn("reset: still alive " .. KILL_TIMEOUT .. "s after the health write, using keys")
    notifyUser("mm2", "The offset reset didn't work, so resetting with Esc + R + Enter.")
  end
  return Reset.keysStep()
end

local VK_I, VK_O = 0x49, 0x4F
local AntiAfk = {nextAt = nil, queue = nil, note = "off", runs = 0}
local AFK_EVERY, AFK_CYCLES = 60, 5
function AntiAfk.step()
  if not (Settings.antiAfk and Settings.farm) then
    AntiAfk.queue, AntiAfk.nextAt = nil, nil
    AntiAfk.note = Settings.antiAfk and "waiting for the farm" or "off"
    return 0.5
  end
  local t = Util.now()
  AntiAfk.nextAt = AntiAfk.nextAt or (t + AFK_EVERY)
  if not AntiAfk.queue then
    if t < AntiAfk.nextAt then AntiAfk.note = "waiting" return 0.5 end
    AntiAfk.queue = {}
    for _ = 1, AFK_CYCLES do AntiAfk.queue[#AntiAfk.queue + 1] = VK_I AntiAfk.queue[#AntiAfk.queue + 1] = VK_O end
  end
  if Reset.active then return 0.25 end
  if not Util.get(isrbxactive) then AntiAfk.note = "click into Roblox" return 0.25 end
  local vk = table.remove(AntiAfk.queue, 1)
  if vk then Reset.press(vk) end
  if #AntiAfk.queue == 0 then
    AntiAfk.queue, AntiAfk.nextAt, AntiAfk.runs = nil, t + AFK_EVERY, AntiAfk.runs + 1
  else AntiAfk.note = "pressing I and O" end
  return 0.12
end

local VOTE_BEST = {"hotel", "bank2", "house2", "barn", "spaceship", "researchfacility"}
local VOTE_WORST = {"vampirecastle", "milbase", "biolab", "policestation", "factory"}
local VOTE_ALIAS = {hotel2 = "hotel", vampirescastle = "vampirecastle"}
local Vote = {sig = nil, pick = nil, pickName = nil, movedAt = -10, note = "off",
  openAt = -100, char = nil, landedAt = nil, counted = false, killed = false, killedAt = -10, kills = 0, fails = 0, noKill = false,
  cast = 0, total = 0}
local VOTE_LAND, VOTE_STACK_FOR, VOTE_RESPAWN, VOTE_MAX_FAILS = 0.15, 13, 0.5, 20
function Vote.key(name)
  local k = tostring(name or ""):lower():gsub("[^%w]", "")
  return VOTE_ALIAS[k] or k
end
function Vote.score(name)
  local k = Vote.key(name)
  for i, m in ipairs(VOTE_BEST) do if m == k then return 100 - i end end
  for i, m in ipairs(VOTE_WORST) do if m == k then return -i end end
  return 0
end
function Vote.pads()
  local folder = Util.get(function() return workspace.Lobby.VotePads end)
  if not folder then return nil end
  local out = {}
  for i = 1, 3 do
    local pad = folder:FindFirstChild("VotePad" .. i)
    local name = pad and Util.get(function() return pad.VoteInfoGui.Container.MapName.Text end)
    local part = pad and pad:FindFirstChild("Pad")
    if not (name and part) then return nil end
    local votes = Util.get(function() return pad.VoteInfoGui.Container.Votes.Text end)
    out[i] = {name = name, part = part, votes = tonumber(type(votes) == "string" and votes:match("%d+") or "")}
  end
  return out
end
function Vote.step()
  if not Settings.autoVote then Vote.note, Vote.sig = "off", nil return 0.5 end
  local pads = Vote.pads()
  if not pads then Vote.note = "no vote pads" return 1 end
  local sig = pads[1].name .. "|" .. pads[2].name .. "|" .. pads[3].name
  if sig ~= Vote.sig then
    if Vote.sig and Vote.kills > 0 then Log.info("vote: re-voted " .. Util.count(Vote.kills, "time", "times") .. " for " .. tostring(Vote.pickName)) end
    Vote.openAt = Vote.sig and Util.now() or -100
    Vote.sig, Vote.pick, Vote.kills, Vote.fails, Vote.noKill, Vote.cast, Vote.mapVotes = sig, 1, 0, 0, false, 0, 0
    for i = 2, 3 do if Vote.score(pads[i].name) > Vote.score(pads[Vote.pick].name) then Vote.pick = i end end
    Vote.pickName = pads[Vote.pick].name
    Log.info("vote: " .. pads[1].name .. " / " .. pads[2].name .. " / " .. pads[3].name .. " -> " .. Vote.pickName)
  end
  local onPad = pads[Vote.pick].votes
  if onPad and onPad > (Vote.mapVotes or 0) then Vote.mapVotes = onPad end
  local ch = Players.LocalPlayer.Character
  local id = ch and Util.get(function() return ch.Address end)
  local hum = ch and ch:FindFirstChildOfClass("Humanoid")
  local hp = hum and Util.get(function() return hum.Health end)
  local t = Util.now()
  if id ~= Vote.char then Vote.char, Vote.landedAt, Vote.killed, Vote.counted = id, nil, false, false end
  if Vote.killed and hp and hp > 0 and t - Vote.killedAt > VOTE_RESPAWN then Vote.landedAt, Vote.killed, Vote.counted = nil, false, false end
  local root = ch and ch:FindFirstChild("HumanoidRootPart")
  local here = root and Util.get(function() return root.Position end)
  local lobby = Farm.lobbyPos()
  if not (here and lobby) or (here - lobby).Magnitude > 300 then Vote.note = "waiting for the lobby" return 0.25 end
  local target = Util.get(function() return pads[Vote.pick].part.Position end)
  if not target then return 0.05 end
  if (here - target).Magnitude > 3 then
    if t - Vote.movedAt > 0.2 then
      Vote.movedAt = t
      pcall(function() root.Position = Vector3.new(target.X, target.Y + 0.5, target.Z) end)
    end
    Vote.landedAt, Vote.note = nil, "going to " .. Vote.pickName
    return 0.05
  end
  if not Vote.counted and hp and hp > 0 and t - Vote.openAt < 17 then
    Vote.counted, Vote.cast, Vote.total = true, Vote.cast + 1, Vote.total + 1
  end
  Vote.landedAt = Vote.landedAt or t
  Vote.note = "voting " .. Vote.pickName
  local stacking = t - Vote.openAt < VOTE_STACK_FOR and not Vote.noKill
  if stacking and not Vote.killed and t - Vote.landedAt >= VOTE_LAND then
    local a = hum and Reset.healthAddress(hum)
    if a then
      for _, off in ipairs(HEALTH_OFFSETS) do pcall(memory_write, "float", a + off, 0) end
      Vote.killed, Vote.killedAt, Vote.kills, Vote.fails = true, t, Vote.kills + 1, 0
      Vote.note = "re-voting " .. Vote.pickName .. " (" .. Vote.kills .. ")"
    else
      Vote.fails = Vote.fails + 1
      if Vote.fails >= VOTE_MAX_FAILS then
        Vote.noKill = true
        Log.warn("vote: health offsets unavailable this vote (Unsafe LuaU is off or Roblox updated), just standing on the pad")
      end
    end
  end
  return 0.05
end

